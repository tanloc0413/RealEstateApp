<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.CAMERA"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Include this permission to grab user's general location -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Include only if your app benefits from precise location access. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RealEstate"
        tools:targetApi="31">

        <meta-data
            android:name="com.mapbox.maps.token"
            android:value="@string/mapbox_access_token" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.RegisterEmailActivity"
            android:exported="false" />
        <activity
            android:name=".activities.PropertyDetailActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ProfileEditActivity"
            android:exported="false" />
        <activity
            android:name=".activities.PostAddActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MyPropertyListActivity"
            android:exported="false" />
        <activity
            android:name=".activities.LoginPhoneActivity"
            android:exported="false" />
        <activity
            android:name=".activities.LoginOptionsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.LoginEmailActivity"
            android:exported="false" />
        <activity
            android:name=".activities.LocationPickerActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ChangePasswordActivity"
            android:exported="false" />

    </application>

</manifest>